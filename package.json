{
  "name": "montagen",
  "private": true,
  "workspaces": [
    "packages/schema",
    "packages/core",
    "packages/server",
    "packages/player",
    "packages/ui",
    "packages/cli",
    "packages/mcp"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/server dev",
    "build": "bun run --cwd packages/ui build",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/bun": "^1.3.14",
    "@vitest/ui": "^3.2.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
